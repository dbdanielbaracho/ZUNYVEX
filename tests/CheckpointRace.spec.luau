--!strict
-- Execute with the standalone Luau CLI from the repository root.
local Race = require("../src/ServerScriptService/CheckpointRace")
local r = Race.new(3, 60)
assert(r.start(42, 100))
assert(r.touch(42, 2, 101) == "out_of_order")
assert(r.progress(42) == 1)
assert(not r.start(42, 101))
assert(r.start(43, 101))
assert(r.progress(43) == 1)
assert(r.touch(42, 1, 102) == "checkpoint")
assert(r.touch(42, 1, 103) == "out_of_order")
assert(r.touch(42, 2, 104) == "checkpoint")
local status, elapsed = r.touch(42, 3, 105)
assert(status == "finished" and elapsed == 5)
assert(r.touch(42, 3, 106) == "already_finished")
r.leave(42)
assert(r.progress(42) == nil)
local timeout = Race.new(2, 10)
assert(timeout.start(7, 0))
assert(timeout.touch(7, 1, 11) == "timed_out")
assert(timeout.progress(7) == nil)
assert(timeout.start(7, 12))
assert(r.start(42, 110))
assert(r.touch(43, 1, 102) == "checkpoint")
assert(r.progress(42) == 1)
assert(r.touch(42, 1, 109) == "invalid_time")
assert(r.touch(42, 1, 0/0) == "invalid_time")
assert(r.touch(999, 1, 110) == "not_started")
assert(not r.start(0, 110))
assert(not r.start(1, math.huge))
local boundary = Race.new(2, 10)
assert(boundary.start(1, 0))
assert(boundary.touch(1, 1, 9) == "checkpoint")
assert(boundary.touch(1, 2, 10) == "finished")
print("CheckpointRace spec passed")
