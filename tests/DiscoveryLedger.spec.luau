local L = require("../src/ReplicatedStorage/DiscoveryLedger")
local state = {}
assert(not L.claim(state, 1, ""))
assert(L.claim(state, 1, "sunset"))
assert(not L.claim(state, 1, "sunset"))
assert(L.claim(state, 2, "sunset"))
assert(L.claim(state, 1, "forest"))
assert(not L.claim(state, 1, "sunset"))
assert(L.claim({}, 1, "sunset"))
-- Moon discovery is independent of existing islands and other players.
assert(L.claim(state, 1, "moon"))
assert(not L.claim(state, 1, "moon"))
assert(L.claim(state, 2, "moon"))
assert(not L.claim(state, 2, "moon"))
assert(not L.claim(state, 1, "forest"))
assert(L.claim({}, 1, "moon"))
-- Observatory reward must be independent of the moon island discovery.
assert(L.claim(state, 1, "moon-observatory"))
assert(not L.claim(state, 1, "moon-observatory"))
assert(not L.claim(state, 1, "moon"))
assert(L.claim(state, 2, "moon-observatory"))
assert(not L.claim(state, 2, "moon-observatory"))
local fresh = {}
assert(L.claim(fresh, 3, "moon-observatory"))
assert(L.claim(fresh, 3, "moon"))
assert(not L.claim(fresh, 3, "moon-observatory"))
print("DiscoveryLedger spec passed")
