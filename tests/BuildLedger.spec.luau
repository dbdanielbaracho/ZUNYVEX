local Ledger = require("../src/ServerScriptService/BuildLedger")
local s = Ledger.new(80)
assert(s.place(1,"shared"))
assert(not s.place(2,"shared"))
assert(not s.remove(2,"shared"))
assert(s.count(1)==1 and s.count(2)==0)
assert(s.place(2,"other"))
for i=1,79 do assert(s.place(1,tostring(i))) end
assert(s.count(1)==80)
assert(not s.place(1,"overflow"))
assert(s.remove(1,"shared"))
assert(not s.remove(1,"shared"))
assert(s.place(2,"shared"))
assert(s.place(1,"replacement"))
assert(#s.clear(1)==80)
assert(s.count(1)==0 and s.count(2)==2)
assert(s.place(1,"replacement"))
assert(not s.place(1,"shared"))
assert(#s.clear(1)==1)
assert(#s.clear(1)==0)
local c = Ledger.new(3)
assert(c.place(1,"a") and c.place(1,"b") and c.place(2,"c"))
assert(not c.remove(2,"a"))
assert(c.setCollaborator(1,2,true))
assert(not c.setCollaborator(1,1,true))
assert(c.ownerOf("a")==1)
assert(not c.remove(3,"a"))
assert(not c.remove(1,"c"))
assert(c.remove(2,"a"))
assert(c.count(1)==1 and c.count(2)==1)
assert(c.setCollaborator(1,2,false))
assert(not c.remove(2,"b"))
assert(c.setCollaborator(1,2,true))
c.clear(2)
assert(not c.remove(2,"b"))
assert(c.setCollaborator(1,2,true))
c.clear(1)
assert(c.place(1,"new"))
assert(not c.remove(2,"new"))
print("BuildLedger spec passed")
