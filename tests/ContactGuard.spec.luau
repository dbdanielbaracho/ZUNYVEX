local Guard = require("../src/ReplicatedStorage/ContactGuard")
assert(Guard.near(0, 10))
assert(Guard.near(10, 10))
assert(not Guard.near(10.01, 10))
assert(not Guard.near(-1, 10))
assert(not Guard.near(0/0, 10))
assert(not Guard.near(math.huge, 10))
assert(not Guard.near(1, math.huge))
assert(not Guard.near(1, -1))
assert(not Guard.near(1, 0/0))
print("ContactGuard spec passed")
