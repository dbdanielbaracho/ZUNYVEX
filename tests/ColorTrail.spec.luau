local T=require("../src/ReplicatedStorage/ColorTrail")
local a,b=T.start(10),T.start(20)
assert(T.touch(a,2,11)=="ignored")
assert(T.touch(a,1,12)=="advanced")
assert(T.touch(a,1,13)=="ignored")
assert(b.nextGate==1)
assert(T.touch(a,2,14)=="advanced")
assert(T.touch(a,3,15)=="advanced")
assert(T.touch(a,4,40)=="finished")
assert(T.touch(a,4,40)=="ignored")
assert(T.touch(b,1,51)=="expired")
assert(T.touch(b,1,52)=="ignored")
assert(T.touch(T.start(10),1,9)=="expired")
print("ColorTrail spec passed")
