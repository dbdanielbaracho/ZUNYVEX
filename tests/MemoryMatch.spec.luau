local M = require("../src/ReplicatedStorage/MemoryMatch")
local a=M.start({1,3,2,4},0)
local b=M.start({4,2,1,3},0)
assert(M.touch(a,1,1)=="advanced")
assert(b.nextIndex==1)
assert(M.touch(a,3,2)=="advanced")
assert(M.touch(a,2,3)=="advanced")
assert(M.touch(a,4,25)=="finished")
assert(M.touch(a,4,25)=="ignored")
assert(M.touch(b,1,1)=="wrong")
assert(M.touch(b,4,2)=="ignored")
assert(M.touch(M.start({1,2,3,4},0),1,26)=="expired")
assert(M.touch(M.start({1,2,3,4},0),0,1)=="ignored")
print("MemoryMatch spec passed")
