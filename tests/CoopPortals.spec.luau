--!strict
local Coop = require("../src/ReplicatedStorage/CoopPortals")
local s = Coop.new()
assert(Coop.touch(s,1,1,0)=="waiting")
assert(Coop.touch(s,1,2,1)=="ignored")
assert(Coop.touch(s,2,1,2)=="ignored")
local result, partner = Coop.touch(s,2,2,8)
assert(result=="finished" and partner==1)
assert(s.player==nil and s.pad==nil)
assert(Coop.touch(s,2,2,9)=="waiting")
assert(Coop.touch(s,3,1,18)=="waiting")
assert(s.player==3)
Coop.leave(s,2)
assert(s.player==3)
Coop.leave(s,3)
assert(s.player==nil)
assert(Coop.touch(s,1,3,20)=="ignored")
assert(Coop.touch(s,0/0,1,20)=="ignored")
assert(Coop.touch(s,1,1,math.huge)=="ignored")
assert(Coop.touch(s,1,1,-1)=="ignored")
assert(Coop.touch(s,1,1,20)=="waiting")
local other=Coop.new()
assert(Coop.touch(other,2,2,21)=="waiting")
assert(s.player==1 and other.player==2)
assert(Coop.touch(s,2,2,19)=="waiting")
assert(s.player==2)
print("PASS CoopPortals")
