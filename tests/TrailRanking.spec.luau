local R = require("../src/ReplicatedStorage/TrailRanking")
local s = {}
assert(not R.record(s,1,0))
assert(not R.record(s,1,0/0))
assert(not R.record(s,1,math.huge))
assert(not R.record(s,1,31))
assert(R.record(s,2,10))
assert(R.record(s,1,10))
assert(not R.record(s,1,11))
assert(not R.record(s,1,10))
assert(R.record(s,3,9))
assert(R.top(s,2)[1].userId == 3)
assert(R.top(s,2)[2].userId == 1)
assert(#R.top(s,2)==2)
assert(R.record(s,2,8.1234))
assert(R.top(s,3)[1].milliseconds==8123)
assert(#R.top(s,0)==0)
print("TrailRanking spec passed")
